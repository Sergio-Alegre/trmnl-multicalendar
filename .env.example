# Copy this file to .env and fill in your own values. The real .env is ignored by git,
# so never commit it: it holds private calendar and webhook URLs.

# Calendar feeds (required): one or more ICS URLs separated by a comma (,).
TRMNL_ICS_URL=https://example.com/calendar-1.ics,https://example.com/calendar-2.ics

# Your timezone (required): an IANA name such as Europe/Madrid or America/Los_Angeles.
# Times are shown in this timezone and the week starts on Monday in it.
TRMNL_TZ=Europe/Madrid

# Language of the weekday and month names shown on the screen (optional). Leave it unset for
# English. The locale has to exist on the machine running the script; on Linux check the
# available ones with `locale -a`.
#TRMNL_LOCALE=es_ES.UTF-8

# Webhook URL of each TRMNL plugin. Only the views with a URL are generated and sent,
# so leave out the ones you do not use.
TRMNL_WEBHOOK_URL_WEEK_CURRENT=https://your-server.example/api/custom_plugins/CURRENT-WEEK-PLUGIN-UUID
TRMNL_WEBHOOK_URL_WEEK_NEXT=https://your-server.example/api/custom_plugins/NEXT-WEEK-PLUGIN-UUID
TRMNL_WEBHOOK_URL_MONTH=https://your-server.example/api/custom_plugins/MONTH-PLUGIN-UUID

# Debug (optional): prints, for each view, whether it was skipped as unchanged or the generated
# HTML with the webhook response. Any non-empty value turns it on, even 0 or false, so keep
# the line commented out (or empty) to disable it.
#DEBUG=1
